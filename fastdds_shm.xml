<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://eprosima.com" fixed_xsd="true">
    <transport_descriptors>
        <!-- 1. Сверхбыстрая разделяемая память -->
        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
        </transport_descriptor>
        
        <!-- 2. Оптимизированная сеть UDP на случай межконтейнерной изоляции -->
        <transport_descriptor>
            <transport_id>custom_udp</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>4194304</receiveBufferSize>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="default_shm_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>shm_transport</transport_id>
                <transport_id>custom_udp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
